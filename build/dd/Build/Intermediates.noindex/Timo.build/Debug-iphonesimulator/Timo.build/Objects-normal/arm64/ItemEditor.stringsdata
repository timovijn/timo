      {
        "comment": "",
        "key": "Turn on iCloud in Settings to share.",
        "location": {
          "startingColumn": 22,
          "startingLine": 575
        }
      },
      {
        "comment": "",
        "key": "Everyone sees the same item and one tick completes it for all. Your reminders and personas stay your own. A repeating item shares every day of it. The first time, someone joins through a link; after that they’re here, and one tap shares with them.",
        "location": {
          "startingColumn": 26,
          "startingLine": 572
        }
      },
      {
        "comment": "",
        "key": "Repeat",
        "location": {
          "startingColumn": 20,
          "startingLine": 610
        }
      },
      {
        "comment": "",
        "key": "Repeat",
        "location": {
          "startingColumn": 24,
          "startingLine": 631
        }
      },
      {
        "comment": "",
        "key": "Starts on the first matching day on or after the selected date. Changes to the original item, including how it repeats, apply to all its linked items. Changing how a linked item repeats unlinks it and makes it a new original item. Completion is separate for each item. The Carry over setting controls whether unfinished items move to the next day.",
        "location": {
          "startingColumn": 24,
          "startingLine": 635
        }
      },
      {
        "comment": "",
        "key": "Repeat this item every day, every weekday, every week or on days you choose. Each occurrence is completed separately. The Carry over setting controls whether unfinished items move to the next day.",
        "location": {
          "startingColumn": 24,
          "startingLine": 636
        }
      },
